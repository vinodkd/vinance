{
  "name": "vinance",
  "version": "0.1.0",
  "description": "Local personal finance management",
  "homepage": "https://github.com/vinodkd/vinance",
  "author": {
    "name": "vinodkd",
    "email": "vinod@vinodkd.org"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev":     "electron-vite dev",
    "build":   "electron-vite build",
    "preview": "electron-vite preview",
    "lint":    "eslint src --ext .js,.jsx",
    "dist":    "npm run build && electron-builder",
    "dist:mac":   "npm run build && electron-builder --mac",
    "dist:win":   "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.vinance.app",
    "productName": "Vinance",
    "copyright": "Copyright © 2024",
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "files": [
      "out/**/*",
      "node_modules/sql.js/dist/*.wasm"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to":   "sql-wasm.wasm"
      }
    ],
    "directories": {
      "buildResources": "build-assets",
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build-assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "build-assets/icon.ico",
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "linux": {
      "icon": "build-assets/icon.png",
      "category": "Finance",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "vite": "^5.1.4"
  },
  "dependencies": {
    "@headlessui/react": "^2.0.3",
    "autoprefixer": "^10.4.18",
    "sql.js": "^1.14.1",
    "ofx-js": "^0.2.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "tailwindcss": "^3.4.1"
  }
}
